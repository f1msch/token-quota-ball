# 索引内统一使用 LF，检出时按具体类型处理
* text=auto eol=lf

# Windows 批处理必须保持 CRLF，否则 cmd.exe 可能解析出错
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制资源不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.exe binary
*.dll binary

# 锁文件保持文本，便于审查依赖变更
package-lock.json text eol=lf
Cargo.lock text eol=lf
